# Copy to .env (gitignored). Never commit real keys.
ANTHROPIC_API_KEY=
# neatlogs PROJECT api key from Settings -> API keys (not the nlw_ HTTP ingest key)
NEATLOGS_API_KEY=
MARGIN_BENCH_BUDGET_USD=50
# Where the agent's model calls go: anthropic (default) or litellm (the event's shared, OpenAI-compatible proxy).
MARGIN_PROVIDER=anthropic
LITELLM_API_KEY=
LITELLM_BASE_URL=https://litellm.vision.aivar.app/v1
