+def reply(content=None, tool_calls=None, finish="stop", usage=None):
+    return {"model": "claude-haiku", "choices": [{"finish_reason": finish, "message": {
+        "role": "assistant", "content": content, "tool_calls": tool_calls}}], "usage": usage or {}}
+
