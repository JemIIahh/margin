+    assert r.stop_reason == "tool_use"
+    assert [type(b) for b in r.content] == [TextBlock, ToolUseBlock, ToolUseBlock]
+    assert r.content[1].to_dict() == {"type": "tool_use", "id": "c1", "name": "read_file", "input": {"path": "a.py"}}
+    assert r.content[2].input == {}
