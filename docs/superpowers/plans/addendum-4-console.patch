+  try { p = localStorage.getItem('margin-palette'); } catch (e) { /* the page works without storage */ }
+  document.documentElement.setAttribute('data-palette', p === 'white' ? 'white' : 'black');
+})();
+</script>
+<style>
+:root,[data-palette="black"]{
+  color-scheme:dark;
+  --bg:#000;--surface:#0b0b0b;--surface2:#131313;--surface3:#1c1c1c;--line:#232323;--line2:#363636;
+  --ink:#f5f5f5;--ink2:#b6b6b6;--ink3:#8c8c8c;--on-ink:#000;
+  --cost:#8f8f8f;--margin:#fff;--on-cost:#000;--on-margin:#000;
+  --ok:#4ade9d;--bad:#ff7b7b;--warn:#f0b54a;--focus:#fff;
