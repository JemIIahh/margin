+  --wall:radial-gradient(70% 90% at 82% -12%,#fff 0%,rgba(255,255,255,0) 62%),radial-gradient(60% 80% at -2% 112%,#d6d6db 0%,rgba(214,214,219,0) 60%),linear-gradient(160deg,#e8e8ec,#c8c8cd);
